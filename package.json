{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/product-config.test.ts tests/marketing.test.ts tests/geography.test.ts tests/stories.test.ts tests/auth.test.ts tests/rbac.test.ts tests/server-session.test.ts tests/authz.test.ts tests/require-authorization.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "visual:baseline": "playwright test tests/visual-regression.spec.ts --update-snapshots",
    "visual:test": "playwright test tests/visual-regression.spec.ts",
    "emulators:auth": "firebase emulators:start --only auth --project demo-nyavista",
    "test:auth:emulator": "firebase emulators:exec --only auth --project demo-nyavista \"node --test tests/auth-emulator.test.ts\"",
    "deploy:rules": "firebase deploy --only firestore:rules,storage:rules -P prod",
    "deploy:rules:firestore": "firebase deploy --only firestore:rules -P prod",
    "deploy:rules:storage": "firebase deploy --only storage:rules -P prod"
  },
  "dependencies": {
    "firebase": "^12.17.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "firebase-tools": "^15.25.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
